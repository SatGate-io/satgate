[{"lucide-react';\nimport RelatedPosts from '@/components/RelatedPosts": "export const metadata = {\n  title: 'How to Control AI Agent API Costs: Rate Limiting vs Economic Firewalls'", 'description': "Rate limiting doesn't understand money. Learn how economic firewalls give you real budget enforcement for AI agent API spend — per agent, per tool, in real time.", 'alternates': {'canonical': 'https://satgate.io/blog/ai-agent-api-cost-control'}, 'keywords': ['AI agent API cost control', 'AI agent budget enforcement', 'API cost management', 'rate limiting vs budget control', 'AI agent spending caps']}, [{'slug': 'what-is-an-economic-firewall', 'title': 'What Is an Economic Firewall?'}, {'slug': 'hard-capping-mcp-tool-spend', 'title': 'Hard-Capping MCP Tool Spend'}, {'slug': 'mcp-budget-enforcement-guide', 'title': 'MCP Budget Enforcement Guide'}], {'className=': 'ext-4xl md:text-5xl font-extrabold tracking-tight mb-4', 'Costs': 'Rate Limiting vs Economic Firewalls\n          </h1>\n          <div className=', 'gap-1': 'Calendar size={14'}, {'text-white': 'The Problem: Agents Spend Money Autonomously</h2>\n          <p className=', 'leading-relaxed': 'The question enterprises actually need answered is: <em>&ldquo;What can you afford?&rdquo;</em>\n          </p>\n\n          <div className=', 'shrink-0': 'ize={20'}, {'shrink-0': 'ize={18'}, {'shrink-0': 'ize={18'}, {'routes': 'path: /v1/chat/completions\n    upstream: https://api.openai.com\n    policy:\n      kind: control\n      pay:\n        mode: fiat402\n        enforceBudget: true\n        costCredits: 5\n\n  - path: /v1/embeddings\n    upstream: https://api.openai.com\n    policy:\n      kind: observe  # Just log for now`'}, {'className=': 'ext-gray-500 hover:text-white flex items-center gap-2 transition'}]