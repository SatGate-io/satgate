{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.satgate-io/satgate",
  "description": "Budget, payment and audit controls for AI agent API calls and MCP tool calls.",
  "title": "SatGate \u2013 Economic Firewall for AI Agents",
  "version": "0.5.0",
  "websiteUrl": "https://satgate.io",
  "repository": {
    "url": "https://github.com/SatGate-io/satgate",
    "source": "github"
  },
  "remotes": [
    {
      "type": "sse",
      "url": "https://satgate-mcp-saas.fly.dev/sse",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token minted in SatGate Cloud (MCP Setup)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "satgate-mcp-bridge",
      "version": "1.0.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SATGATE_URL",
          "description": "SatGate Cloud MCP URL",
          "isRequired": true,
          "default": "https://satgate-mcp-saas.fly.dev"
        },
        {
          "name": "SATGATE_TOKEN",
          "description": "Agent token minted in SatGate Cloud (MCP Setup)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
